{
  // Copy this file to appsettings.Local.json (git-ignored) and edit it.
  //
  // Each source describes how one repository turns a commit into a single self-contained
  // OpenAPI document. The visualizer knows nothing about your build - it extracts the paths
  // you list with `git archive` (read-only, your working copy is never touched) and runs the
  // commands you give it.
  //
  // Placeholders available in Steps and SpecFile:
  //   {tree}   root of the extracted archive
  //   {work}   scratch directory for intermediate files
  //   {output} where the last step should write the finished spec
  //   {repo}   the repository path
  "SpecDiff": {
    // Per-command timeout, applied to git and to each build step.
    "StepTimeoutSeconds": 300,

    // Optional. Defaults to a subdirectory of the system temp folder. Built specs are cached
    // by commit id, so re-opening a pull request is instant. Set this to a short path if you
    // hit Windows path-length limits while extracting deeply nested spec files.
    // "CacheDirectory": "C:\\oav-cache",

    "Sources": [
      {
        // Simplest case: the repository commits one self-contained spec file, so there is
        // nothing to build. Point SpecFile at it and omit Steps entirely.
        "Name": "Petstore (single file)",
        "RepoPath": "C:\\src\\petstore-api",
        "ArchivePaths": [ "openapi/openapi.json" ],
        "SpecFile": "{tree}/openapi/openapi.json"
      },
      {
        // Multi-file spec with $refs across files: bundle it into one document first.
        // Any CLI works - this uses Redocly, which needs no install via npx.
        "Name": "Petstore (bundled)",
        "RepoPath": "C:\\src\\petstore-api",
        "ArchivePaths": [ "openapi" ],
        "Steps": [
          {
            "Command": "npx",
            "Arguments": "--yes @redocly/cli@latest bundle \"{tree}/openapi/openapi.yaml\" -o \"{output}\""
          }
        ],

        // Optional. Only needed to diff by pull-request number; diffing two git refs works
        // without it. Azure DevOps Services and on-prem Azure DevOps Server / TFS are
        // supported. GitHub and GitLab are not yet implemented.
        "Ado": {
          "CollectionUrl": "https://dev.azure.com/your-organization",
          "Project": "your-project",
          "Repository": "petstore-api",
          "ApiVersion": "6.0",

          // Environment variable holding a PAT with Code (read) scope. When it is unset the
          // client falls back to the current Windows identity, which is usually enough for
          // an on-prem server on a domain-joined machine.
          "PatEnvironmentVariable": "ADO_PAT",

          // Git remote used to fetch pull-request refs.
          "Remote": "origin"
        }
      },
      {
        // Several steps run in order. Use {work} for intermediates and have the last step
        // write {output}. This shape suits repositories that merge multiple services into
        // one combined document.
        "Name": "Combined (multi-step)",
        "RepoPath": "C:\\src\\monorepo",
        "ArchivePaths": [ "services/public/spec", "services/internal/spec" ],
        "Steps": [
          {
            "Command": "npx",
            "Arguments": "--yes @redocly/cli@latest bundle \"{tree}/services/public/spec/openapi.yaml\" -o \"{work}/public.json\""
          },
          {
            "Command": "npx",
            "Arguments": "--yes @redocly/cli@latest bundle \"{tree}/services/internal/spec/openapi.yaml\" -o \"{work}/internal.json\""
          },
          {
            "Command": "your-merge-tool",
            "Arguments": "--source \"{work}/public.json\" --target \"{work}/internal.json\" --out \"{output}\""
          }
        ]
      }
    ]
  }
}
